{
    "name": "ssx/wiretap-guzzle",
    "description": "Guzzle capture for wiretap. Records outbound requests and responses from clients you construct yourself.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "http",
        "guzzle",
        "debugging",
        "logging",
        "middleware"
    ],
    "authors": [
        {
            "name": "Scott Robinson",
            "email": "scott@dor.ky"
        }
    ],
    "require": {
        "php": "^8.2",
        "ssx/wiretap": "~0.0.19 || dev-main",
        "guzzlehttp/guzzle": "^7.5",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.34",
        "phpstan/phpstan": "^1.11",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "ssx/wiretap-auto": "~0.0.8 || dev-main"
    },
    "suggest": {
        "ssx/wiretap-auto": "Captures vendor code too, with no application changes, via ext-opentelemetry"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ssx/wiretap",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/ssx/wiretap-auto",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "Ssx\\Wiretap\\Guzzle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ssx\\Wiretap\\Guzzle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
